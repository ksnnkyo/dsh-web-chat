{
  "name": "dsh-web-chat",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "dsh-web-chat：在 DeepSeek Harness 中管理 DeepSeek 网页会话、分组，并将对话整理为可预览的任务草稿。",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "web-chat",
    "conversation",
    "handoff",
    "cordis-plugin"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check scripts/update-market.mjs",
    "release:check": "npm run check && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run release:check",
    "market:update": "node scripts/update-market.mjs"
  },
  "author": "ksnnkyo",
  "license": "MIT",
  "homepage": "https://github.com/ksnnkyo/dsh-deepseek-webdesk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksnnkyo/dsh-deepseek-webdesk.git"
  },
  "bugs": {
    "url": "https://github.com/ksnnkyo/dsh-deepseek-webdesk/issues"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  },
  "contributors": [
    "zneoxlab"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
